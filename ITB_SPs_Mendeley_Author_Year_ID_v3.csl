<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" class="in-text" version="1.0" demote-non-dropping-particle="never" default-locale="id-ID">
  <info>
    <title>Institut Teknologi Bandung - Sekolah Pascasarjana (Mendeley Author-Year ID)</title>
    <title-short>ITB - SPs Author-Year ID</title-short>
    <id>http://www.zotero.org/styles/institut-teknologi-bandung-sekolah-pascasarjana-mendeley-author-year-id-v3</id>
    <link href="http://www.zotero.org/styles/institut-teknologi-bandung-sekolah-pascasarjana-mendeley-author-year-id-v3" rel="self"/>
    <link href="http://www.zotero.org/styles/institut-teknologi-bandung-sekolah-pascasarjana" rel="template"/>
    <link href="https://spitm.itb.ac.id/cslen/" rel="documentation"/>
    <link href="https://itb-sps.github.io/csl/" rel="documentation"/>
    <author>
      <name>Firdan Machda</name>
    </author>
    <author>
      <name>Hendy Irawan</name>
    </author>
    <contributor>
      <name>Custom Mendeley Cite author-year modification</name>
    </contributor>
    <category citation-format="author-date"/>
    <category field="engineering"/>
    <summary>Based on the SPs ITB CSL. Modified for Indonesian in-text author-year citations: one author = Smith, 2025; two authors = Smith dan Jones, 2025; three or more authors = Smith dkk., 2025; multiple references are separated by semicolons and preserve insertion order. Patent citations use inventor/author when available.</summary>
    <updated>2026-08-18T19:30:00+07:00</updated>
    <rights license="http://creativecommons.org/licenses/by-sa/3.0/">This derivative work is licensed under a Creative Commons Attribution-ShareAlike 3.0 License.</rights>
  </info>

  <locale xml:lang="id">
    <terms>
      <term name="and">dan</term>
      <term name="et-al">dkk.</term>
      <term name="retrieved">diperoleh</term>
      <term name="from">melalui</term>
      <term name="edition">edisi</term>
      <term name="director">sutradara</term>
      <term name="in">dalam</term>
      <term name="personal-communication">komunikasi pribadi</term>
    </terms>
  </locale>

  <macro name="author-short">
    <names variable="author">
      <name form="short" and="text" delimiter=", " initialize-with=". " et-al-min="3" et-al-use-first="1" delimiter-precedes-et-al="never"/>
      <substitute>
        <names variable="editor"/>
        <names variable="translator"/>
        <choose>
          <if type="patent" match="any">
            <text variable="number"/>
          </if>
          <else-if type="report" match="any">
            <text variable="publisher"/>
            <text variable="title" form="short" font-style="italic"/>
          </else-if>
          <else-if type="legal_case" match="any">
            <text variable="title" font-style="italic"/>
          </else-if>
          <else-if type="bill book graphic legislation motion_picture song" match="any">
            <text variable="title" form="short" font-style="italic"/>
          </else-if>
          <else>
            <text variable="title" form="short" quotes="true"/>
          </else>
        </choose>
      </substitute>
    </names>
  </macro>

  <macro name="author">
    <choose>
      <if type="motion_picture broadcast" match="any">
        <names variable="collection-editor" suffix=" (Produser), "/>
      </if>
    </choose>
    <names variable="author" font-variant="normal">
      <name and="text" delimiter-precedes-last="always" initialize-with=". " name-as-sort-order="all"/>
      <substitute>
        <names variable="editor"/>
        <names variable="translator"/>
        <choose>
          <if type="report" match="any">
            <text variable="publisher"/>
            <text variable="title"/>
          </if>
          <else-if type="patent" match="any">
            <text variable="number"/>
          </else-if>
          <else>
            <text variable="title"/>
          </else>
        </choose>
      </substitute>
    </names>
    <choose>
      <if type="broadcast motion_picture" match="any">
        <text term="director" text-case="capitalize-first" prefix=" (" suffix=")"/>
      </if>
    </choose>
  </macro>

  <macro name="issued-year">
    <choose>
      <if variable="issued">
        <date variable="issued">
          <date-part name="year"/>
        </date>
        <text variable="year-suffix"/>
      </if>
      <else-if variable="status">
        <text variable="status"/>
        <text variable="year-suffix" prefix="-"/>
      </else-if>
      <else>
        <text term="no date" form="short"/>
        <text variable="year-suffix" prefix="-"/>
      </else>
    </choose>
  </macro>

  <macro name="issued-sort">
    <date variable="issued">
      <date-part name="year"/>
      <date-part name="month"/>
      <date-part name="day"/>
    </date>
  </macro>

  <macro name="issued">
    <choose>
      <if variable="issued">
        <group prefix="(" suffix=")">
          <choose>
            <if type="article-journal book chapter graphic motion_picture paper-conference report song dataset patent thesis" match="none">
              <date variable="issued">
                <date-part name="day" suffix=" "/>
                <date-part name="month" suffix=" "/>
              </date>
            </if>
          </choose>
          <date variable="issued">
            <date-part name="year"/>
          </date>
          <text variable="year-suffix"/>
        </group>
      </if>
      <else>
        <group prefix="(" suffix=")">
          <text term="no date" form="short"/>
          <text variable="year-suffix" prefix="-"/>
        </group>
      </else>
    </choose>
  </macro>

  <macro name="edition">
    <choose>
      <if is-numeric="edition">
        <group delimiter=" ">
          <number variable="edition" form="ordinal"/>
          <text term="edition" form="short"/>
        </group>
      </if>
      <else>
        <text variable="edition"/>
      </else>
    </choose>
  </macro>

  <macro name="title">
    <choose>
      <if type="patent" match="any">
        <text variable="number" font-style="italic"/>
      </if>
      <else-if type="book graphic manuscript motion_picture report song speech thesis" match="any">
        <text variable="title" font-style="italic"/>
      </else-if>
      <else-if type="personal_communication" match="any">
        <text term="personal-communication" text-case="capitalize-first"/>
      </else-if>
      <else>
        <text variable="title"/>
      </else>
    </choose>
  </macro>

  <macro name="title-plus-extra">
    <text macro="title"/>
    <choose>
      <if type="report book chapter" match="any">
        <group prefix=" (" suffix=")" delimiter=", ">
          <text macro="edition"/>
          <group delimiter=" ">
            <text variable="genre"/>
            <text variable="number"/>
          </group>
        </group>
      </if>
      <else-if type="thesis" match="any">
        <text variable="genre" prefix=", "/>
      </else-if>
      <else-if type="post-weblog webpage" match="any">
        <text variable="genre" prefix=" [" suffix="]"/>
      </else-if>
    </choose>
  </macro>

  <macro name="container-contributors">
    <choose>
      <if type="chapter paper-conference entry-dictionary entry-encyclopedia" match="any">
        <names variable="editor" delimiter=", " suffix=", ">
          <name and="text" initialize-with=". " delimiter=", "/>
          <label form="short" text-case="lowercase" prefix=", " suffix=","/>
        </names>
      </if>
    </choose>
  </macro>

  <macro name="container-title">
    <choose>
      <if type="article article-journal article-magazine article-newspaper" match="any">
        <text variable="container-title" font-style="italic"/>
      </if>
      <else-if type="report" match="any">
        <text variable="container-title"/>
      </else-if>
      <else>
        <text variable="container-title" font-style="italic"/>
      </else>
    </choose>
  </macro>

  <macro name="container">
    <choose>
      <if type="chapter" match="any">
        <group>
          <text term="in" text-case="lowercase" font-style="italic" suffix=" "/>
          <text macro="container-contributors"/>
          <text macro="container-title"/>
        </group>
      </if>
      <else-if type="post-weblog webpage motion_picture patent" match="none">
        <text macro="container-title"/>
      </else-if>
    </choose>
  </macro>

  <macro name="publisher">
    <choose>
      <if type="article-journal article-magazine post-weblog webpage" match="none">
        <group delimiter=", ">
          <text variable="publisher"/>
          <text variable="publisher-place"/>
        </group>
      </if>
    </choose>
  </macro>

  <macro name="locators">
    <choose>
      <if type="article-journal article-magazine" match="any">
        <group prefix=", " delimiter=", ">
          <group>
            <text variable="volume" font-weight="bold"/>
            <text variable="issue" prefix="(" suffix=")"/>
          </group>
          <text variable="page"/>
        </group>
      </if>
      <else-if type="article-newspaper" match="any">
        <group delimiter=" " prefix=", ">
          <label variable="page" form="short"/>
          <text variable="page"/>
        </group>
      </else-if>
      <else-if type="book graphic motion_picture report song paper-conference entry-encyclopedia entry-dictionary thesis" match="any">
        <group delimiter=", " prefix=", ">
          <text variable="volume" font-weight="bold"/>
          <text variable="page"/>
          <text variable="number-of-pages"/>
        </group>
      </else-if>
    </choose>
  </macro>

  <macro name="access">
    <choose>
      <if variable="DOI" match="none">
        <choose>
          <if variable="URL">
            <group delimiter=" ">
              <text term="retrieved" text-case="lowercase"/>
              <choose>
                <if variable="accessed">
                  <date variable="accessed" form="text" suffix=","/>
                </if>
              </choose>
              <text term="from"/>
              <text value="situs internet:"/>
              <text variable="URL"/>
            </group>
          </if>
        </choose>
      </if>
    </choose>
  </macro>

  <macro name="citation-locator">
    <group>
      <label variable="locator" form="short"/>
      <text variable="locator" prefix=" "/>
    </group>
  </macro>

  <citation et-al-min="3" et-al-use-first="1" et-al-subsequent-min="3" et-al-subsequent-use-first="1" disambiguate-add-year-suffix="true" disambiguate-add-names="false" disambiguate-add-givenname="false" collapse="year">
    <layout prefix="(" suffix=")" delimiter="; ">
      <group delimiter=", ">
        <text macro="author-short"/>
        <text macro="issued-year"/>
        <text macro="citation-locator"/>
      </group>
    </layout>
  </citation>

  <bibliography hanging-indent="true" entry-spacing="0" line-spacing="1">
    <sort>
      <key macro="author"/>
      <key macro="issued-sort" sort="ascending"/>
      <key macro="title"/>
    </sort>
    <layout>
      <group suffix=".">
        <group>
          <group delimiter=" ">
            <text macro="author"/>
            <text macro="issued"/>
          </group>
          <text value=": "/>
        </group>
        <group delimiter=", ">
          <text macro="title-plus-extra"/>
          <choose>
            <if type="chapter" match="any">
              <text variable="page"/>
            </if>
          </choose>
        </group>
        <choose>
          <if type="chapter" match="all" variable="container-title"/>
          <else-if match="all" variable="container-title author">
            <text value=", "/>
          </else-if>
        </choose>
        <text macro="container"/>
        <group delimiter="," prefix=", ">
          <text macro="publisher"/>
          <text macro="access" prefix=" "/>
        </group>
        <text macro="locators"/>
      </group>
      <text variable="DOI" prefix=" https://doi.org/"/>
    </layout>
  </bibliography>
</style>
